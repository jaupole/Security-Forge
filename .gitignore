# === SECRETS / CREDENTIALS (NON-NEGOTIABLE — never commit) ===
# Shamir keys + recovery material
**/shamir-keys/
**/unseal-keys.txt
**/recovery-key*

# OpenBao / Vault tokens, root tokens, init artifacts
**/openbao-init-output*
**/openbao-recovery-keys*
**/transit-token*
**/.bao-token

# mkcert CA private keys (the public root cert can be tracked; the private key cannot)
**/rootCA-key.pem
infrastructure/mkcert/*-key.pem

# Generic key/cert/credential patterns outside known good locations
*.key
!infrastructure/**/*.pub.key
!docs/**/*.key
*.pem
!infrastructure/cert-manager/**/*.pem
!infrastructure/wazuh/vendor/**/*.pem
*.p12
*.pfx
*.jks

# .env files (any .env, anywhere)
.env
.env.*
!.env.example

# === PER-MACHINE / PER-USER STATE (not project state) ===
.claude/settings.local.json
.claude/projects/
.claude/cache/
.claude/sessions/
.claude/state/
.claude/*.lock
.vscode/
.idea/
*.iml
.swp
.swo
*~
.DS_Store
Thumbs.db

# === BUILD / GENERATED ARTIFACTS ===
# Go binaries (named after their containing dir)
apps/helloworld-bff/helloworld-bff
apps/helloworld-backend/helloworld-backend
apps/authzen-facade/authzen-facade
# Windows-built Go output (any service compiled on a Windows host)
*.exe
*.exe~
**/vendor/
!infrastructure/wazuh/vendor/
!apps/lib/

# === LOCAL-DEV VENDORED TOOLCHAINS ===
# Hand-downloaded tarballs/archives for SpiceDB CLI, zed, etc. Operator
# fetches these from upstream; they live in local-dev/bin/ but are not
# committed (tens of MB each, license-burdened).
local-dev/bin/*.zip
local-dev/bin/*.tar.gz
local-dev/bin/*.tgz
local-dev/bin/completions/

# Go build/test
*.test
*.out
coverage.txt

# Helm vendored .tgz (the unpacked chart is committed; the tarball is not)
infrastructure/wazuh/vendor/wazuh/charts/*.tgz

# === OPERATOR SCRATCHPAD / EPHEMERAL ===
notes/

# === LOGS / TEMP ===
*.log
!docs/**/*.log
*.tmp
/tmp/

# === KUBECTL DUMPS, DEBUG OUTPUTS ===
kubectl-dump-*.yaml
*-debug.log
*-baseline-*

# === SBOM / PROVENANCE (keep — audit-relevant) ===
# (intentionally NOT ignored: apps/*/sbom/* — these are signed audit artifacts)
