  "panels": [
    {
      "title": "Audit log requests / sec",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(vault_audit_log_request_count{namespace=\"openbao\"}[5m]))", "legendFormat": "requests", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(vault_audit_log_response_count{namespace=\"openbao\"}[5m]))", "legendFormat": "responses", "refId": "B"}
      ]
    },
    {
      "title": "Login requests / sec (auth methods)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(vault_core_handle_login_request_count{namespace=\"openbao\"}[5m]))", "legendFormat": "logins", "refId": "A"}
      ]
    },
    {
      "title": "Locked users",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "id": 3,
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(vault_core_locked_users{namespace=\"openbao\"})", "refId": "A"}
      ]
    },
    {
      "title": "Audit log failures / sec",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8},
      "id": 4,
      "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.001}]}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(vault_audit_log_request_failure{namespace=\"openbao\"}[5m]))", "refId": "A"}
      ]
    },
    {
      "title": "Audit log latency p99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vault_audit_log_request{namespace=\"openbao\",quantile=\"0.99\"}", "legendFormat": "request p99", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "vault_audit_log_response{namespace=\"openbao\",quantile=\"0.99\"}", "legendFormat": "response p99", "refId": "B"}
      ]
    },
    {
      "title": "OpenBao audit (Loki)",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 14},
