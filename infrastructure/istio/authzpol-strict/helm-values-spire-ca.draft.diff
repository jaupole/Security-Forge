# Phase 7c (DRAFT, not applied) — Istio SPIRE-as-CA helm-values diff.
#
# Apply via:
#   helm upgrade istio-base istio/base -n istio-system -f infrastructure/istio/01-base-values.yaml
#   helm upgrade istiod      istio/istiod -n istio-system -f infrastructure/istio/02-istiod-values.yaml
#   helm upgrade ztunnel     istio/ztunnel -n istio-system -f infrastructure/istio/04-ztunnel-values.yaml
#
# At cutover-time, FIRST validate against the upstream Istio + SPIRE
# compatibility matrix (https://istio.io/latest/docs/ops/integrations/spire/)
# for the chart versions in install.sh. Diff below is a working draft.

# ─── 02-istiod-values.yaml ──────────────────────────────────────────
# Add trustDomain + SPIRE bundle source.

--- a/infrastructure/istio/02-istiod-values.yaml
+++ b/infrastructure/istio/02-istiod-values.yaml
@@ -1,17 +1,33 @@
 # istio/istiod (Ambient profile, local edition).
-# Built-in Citadel CA for now (Phase 6.2 interim); SPIRE-as-CA deferred to 6.2b.
+# SPIRE-as-CA (Phase 7c, 2026-05-XX). ztunnel + waypoints pull SVIDs
+# from the SPIRE workload API; Istio's built-in Citadel is bypassed.
 profile: ambient

-# Trust domain note: ztunnel and waypoints will mint SVIDs as
-# spiffe://cluster.local/... until 6.2b. Cutover to "secforge.local"
-# happens in 6.2b concurrently with the SPIRE-CA wiring.
 meshConfig:
+  # Trust domain MUST match SPIRE's (infrastructure/spire/values.yaml).
+  trustDomain: secforge.local
   accessLogFile: /dev/stdout
   accessLogEncoding: JSON
   enableTracing: true
   defaultProviders:
     tracing:
       - opentelemetry
   extensionProviders:
     - name: opentelemetry
       opentelemetry:
         service: otel-collector.observability.svc.cluster.local
         port: 4317

 pilot:
   replicaCount: 1
   autoscaleEnabled: false
   resources:
     requests:
       cpu: 100m
       memory: 256Mi
     limits:
       cpu: 500m
       memory: 512Mi
   env:
     PILOT_ENABLE_AMBIENT: "true"
+    # Disable in-tree Citadel issuer; the workload API is the issuer.
+    EXTERNAL_CA: "true"
+    # SPIRE bundle endpoint that istiod consumes for trust-bundle distribution.
+    PILOT_TRUSTED_GATEWAY_CA_TYPE: "k8s.io/v1.spiffe.io/clusterspiffeid"

 global:
   proxy:
     autoInject: disabled
+
+  # SPIRE bundle source — istiod federates root certs from SPIRE.
+  caAddress: spire-server.spire.svc.cluster.local:8081

# ─── 04-ztunnel-values.yaml ─────────────────────────────────────────
# Mount the SPIRE Workload API CSI; ztunnel reads SVIDs from there.

--- a/infrastructure/istio/04-ztunnel-values.yaml
+++ b/infrastructure/istio/04-ztunnel-values.yaml
@@ -1,14 +1,33 @@
 # istio/ztunnel (Ambient L4 dataplane)
-# DaemonSet on every node; in 6.2 it uses Citadel-issued SVIDs.
-# In 6.2b we'll mount the SPIRE Workload API socket and consume SPIRE SVIDs.
+# Phase 7c (2026-05-XX): SVIDs from SPIRE via the Workload API
+# CSI driver. Citadel is bypassed.
 resources:
   requests:
     cpu: 50m
     memory: 128Mi
   limits:
     cpu: 500m
     memory: 256Mi

 logLevel: info
 logAsJson: true
+
+# SPIRE Workload API socket — read SVIDs from SPIRE.
+# Path is the standard CSI driver mount.
+extraVolumes:
+  - name: spiffe-workload-api
+    csi:
+      driver: csi.spiffe.io
+      readOnly: true
+
+extraVolumeMounts:
+  - name: spiffe-workload-api
+    mountPath: /var/run/secrets/workload-spiffe-uds
+    readOnly: true
+
+env:
+  - name: CA_ADDRESS
+    value: "unix:///var/run/secrets/workload-spiffe-uds/socket"
+  - name: XDS_ROOT_CA
+    value: "/var/run/secrets/workload-spiffe-uds/ca.crt"
+  - name: ISTIO_META_CA_PROVIDER
+    value: "spire"

# ─── Prerequisites for the diff to apply cleanly ────────────────────
# 1. SPIRE has been issuing SVIDs to mesh pods all along — verify with:
#      kubectl exec -n istio-system <ztunnel-pod> -- ls -la /var/run/secrets/workload-spiffe-uds/
#    (Should already be mounted by SPIRE-CSI; the Phase 5 setup put it there.)
#
# 2. SPIRE's federated trust bundle is reachable from istiod's pod IP.
#    (Both run in cluster, no DNS surprises expected.)
#
# 3. ClusterSPIFFEID coverage for the new mesh-enrolled namespaces
#    (keycloak, spicedb, openbao, teleport) is ALREADY in place via
#    `infrastructure/spire/cluster-spiffe-ids.yaml` — no SPIRE-side
#    changes needed for the cutover.
#
# 4. Run the smoke tests in docs/03-runbooks/istio-peer-auth-tighten.md § 3.2
#    BEFORE flipping any namespace's PeerAuthentication to STRICT.
