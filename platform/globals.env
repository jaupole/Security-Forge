# SecForge platform globals — single source of truth for production deployment.
#
# Every values file and manifest in platform/ may reference these as ${VAR}.
# `lib/render.sh` substitutes them at install time via envsubst.
#
# Edit this file and re-run install-all.sh to apply changes across the stack.

# Public domain — used for ingress hostnames, ACME certs, OIDC issuer URLs
DOMAIN=secforge.dev

# SPIFFE trust domain — organizational identity, deliberately decoupled from
# public DNS so a future domain change does NOT trigger fleet-wide SVID
# re-issuance. See plan: "Domain portability + SPIFFE trust domain".
#
# Bare form (no `spiffe://` prefix) — this is what the SPIRE Helm chart expects.
# Consumers needing the full URI use `spiffe://${SPIFFE_TRUST_DOMAIN}`.
SPIFFE_TRUST_DOMAIN=secforge.platform

# k8s_psat cluster name — must match between spire-server and spire-agent.
# Local edition used "docker-desktop"; production uses the cluster's chosen name.
SPIRE_CLUSTER_NAME=secforge-prod

# Let's Encrypt — ClusterIssuer name + ACME registration email
LE_ISSUER=letsencrypt-prod
LE_EMAIL=jaupole@googlemail.com

# Wildcard cert location (issued in Phase B; ingresses reference this secret)
WILDCARD_CERT_NAMESPACE=cert-manager
WILDCARD_CERT_SECRET=secforge-wildcard-tls

# Storage class (k3s default; override if we add Longhorn or external storage)
STORAGE_CLASS=local-path

# Time zone for cron jobs and timestamp displays
TIMEZONE=UTC
