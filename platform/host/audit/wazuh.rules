# Wazuh-recommended auditd rules for SecForge production host.
#
# Target: Ubuntu 24.04 + k3s + SecForge platform stack.
# Goal: capture security-relevant kernel events that complement
#       file-based logs (auth.log, fail2ban.log, k3s-audit, openbao-audit).
#
# Reference: Wazuh documentation §System calls + auditd integration:
#   https://documentation.wazuh.com/current/learning-wazuh/system-calls.html
# Plus CIS Distribution Independent Linux Benchmark v2.0.0 §4.1.
#
# Format: each rule is a single auditctl-syntax line. `augenrules --load`
# concatenates all *.rules in /etc/audit/rules.d/ and applies them.
#
# Apply: copy to /etc/audit/rules.d/wazuh.rules then `augenrules --load`
#        (or `systemctl restart auditd`).

# ─── Reset + buffer + failure mode ────────────────────────────────────
# Delete all existing rules so we start fresh on (re)load.
-D
# Increase backlog buffer (default 8192 is fine; bump to 16384 for safety
# on a busy K8s host where audit volume can spike).
-b 16384
# Failure mode: 1 = printk to syslog (warn but keep going).
# 2 = panic; we don't want a kernel panic if auditd is overwhelmed.
-f 1

# ─── Account, group, password databases (CIS 4.1.7) ───────────────────
-w /etc/group        -p wa -k identity
-w /etc/passwd       -p wa -k identity
-w /etc/gshadow      -p wa -k identity
-w /etc/shadow       -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# ─── sudo + ssh configuration ─────────────────────────────────────────
-w /etc/sudoers      -p wa -k scope
-w /etc/sudoers.d/   -p wa -k scope
-w /etc/ssh/sshd_config    -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd

# ─── Audit configuration tampering (CIS 4.1.4) ────────────────────────
-w /etc/audit/audit.rules    -p wa -k auditconfig
-w /etc/audit/auditd.conf    -p wa -k auditconfig
-w /etc/audit/rules.d/       -p wa -k auditconfig
-w /var/log/audit/           -p wa -k auditlogs

# ─── System startup / shutdown ────────────────────────────────────────
-w /etc/init.d/      -p wa -k init
-w /etc/systemd/     -p wa -k init
-w /sbin/shutdown    -p x  -k power
-w /sbin/poweroff    -p x  -k power
-w /sbin/reboot      -p x  -k power
-w /sbin/halt        -p x  -k power

# ─── Cron / scheduled tasks ──────────────────────────────────────────
-w /etc/cron.allow   -p wa -k cron
-w /etc/cron.deny    -p wa -k cron
-w /etc/cron.d/      -p wa -k cron
-w /etc/cron.daily/  -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/crontab      -p wa -k cron
-w /var/spool/cron/  -p wa -k cron

# ─── Login records (CIS 4.1.10) ───────────────────────────────────────
-w /var/log/lastlog  -p wa -k logins
-w /var/run/faillock -p wa -k logins
-w /var/log/wtmp     -p wa -k session
-w /var/log/btmp     -p wa -k session

# ─── Hostname + network config ───────────────────────────────────────
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k system-locale
-w /etc/hostname     -p wa -k system-locale
-w /etc/hosts        -p wa -k system-locale
-w /etc/network/     -p wa -k system-locale
-w /etc/netplan/     -p wa -k system-locale

# ─── Time changes (CIS 4.1.5) ─────────────────────────────────────────
-a always,exit -F arch=b64 -S adjtimex,settimeofday -k time-change
-a always,exit -F arch=b64 -S clock_settime -k time-change
-w /etc/localtime    -p wa -k time-change

# ─── Kernel module load/unload (CIS 4.1.13) ──────────────────────────
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-w /etc/modprobe.d/  -p wa -k modules

# ─── Privileged command exec (CIS 4.1.12) ────────────────────────────
# We trust EUID 0 (root) — log all execve when EUID changes from non-root,
# i.e., a privilege boundary crossing. Volume should be modest.
-a always,exit -F arch=b64 -C euid!=uid -F auid!=4294967295 -S execve -k privilege-exec

# ─── Mounts (CIS 4.1.11) ─────────────────────────────────────────────
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=4294967295 -k mounts

# ─── Unsuccessful unauth file access (CIS 4.1.9) ─────────────────────
-a always,exit -F arch=b64 -S open,openat,creat,truncate,ftruncate -F exit=-EACCES  -F auid>=1000 -F auid!=4294967295 -k access
-a always,exit -F arch=b64 -S open,openat,creat,truncate,ftruncate -F exit=-EPERM   -F auid>=1000 -F auid!=4294967295 -k access

# ─── File deletions by users (CIS 4.1.14) ────────────────────────────
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=4294967295 -k delete

# ─── DAC permission changes by users ─────────────────────────────────
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=4294967295 -k perm_mod

# ─── k3s + container runtime config tamper ───────────────────────────
-w /etc/rancher/                  -p wa -k k3s-config
-w /var/lib/rancher/k3s/server/   -p wa -k k3s-config
-w /etc/containerd/               -p wa -k container-runtime

# ─── Lock the rules so they can't be modified at runtime (CIS 4.1.3) ─
# This MUST be the very last rule. Prevents anyone (even root) from
# modifying audit rules without a reboot. If you need to change rules,
# edit the file and reboot the host.
#
# Disabled for now during initial tuning — uncomment once we're confident
# the rules don't need adjustment. Re-enable: change `-e 1` to `-e 2`.
-e 1
