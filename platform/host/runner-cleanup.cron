# Cron fragment for the secforge-prod host (install as root).
#
# Install:
#   sudo cp platform/host/runner-cleanup.cron /etc/cron.d/runner-cleanup
#   sudo chmod 644 /etc/cron.d/runner-cleanup
#
# Schedule: 04:00 Europe/Berlin, DAILY (bumped from Mon/Wed/Fri 2026-07-07 —
# NodeDiskSpaceWarn on vg0-runner: one heavy build day regrew volumes + caches
# past the warn threshold inside the 48-72h gap). Runs after the Velero daily
# backup (02:00) and clear of the weekly backup window, to avoid I/O
# contention and capture backup objects before the _work wipe. NOTE:
# /etc/cron.d entries run in the host TZ (Europe/Berlin) — NOT UTC.
#
# Runs as root: runner-cleanup.sh drops to github-runner (uid 1001) for the
# ROOTLESS docker prune and needs root to read the repo + delete runner files.
# Path is the canonical deploy clone on this host (/home/ops/secforge).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

0 4 * * * root bash /home/ops/secforge/platform/scripts/runner-cleanup.sh >> /var/log/runner-cleanup.log 2>&1
