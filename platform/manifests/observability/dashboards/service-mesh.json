      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(istio_tcp_sockets_open)", "refId": "A"}
      ]
    },
    {
      "title": "istiod xDS push (bytes/sec)",
