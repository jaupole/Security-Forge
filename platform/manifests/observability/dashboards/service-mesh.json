      "title": "ztunnel TCP connections opened/closed/failed (/sec)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 5}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(istio_tcp_connections_opened_total[5m]))", "legendFormat": "opened", "refId": "A"},
