        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(istio_tcp_connections_failed_total[5m]))", "legendFormat": "failed", "refId": "C"}
      ]
    },
    {
      "title": "ztunnel throughput (bytes/sec)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(istio_tcp_received_bytes_total[5m]))", "legendFormat": "received", "refId": "A"},
