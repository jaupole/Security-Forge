          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container restarts (last 1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [],
