# Daily ScheduledBackup for control-db.
# 02:45 UTC — 15 min after keycloak's 02:30 to stagger MinIO PUTs.
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: control-db-daily
  namespace: control
  labels:
    secforge.platform/component: cloudnativepg
    secforge.platform/cluster: control-db
spec:
  schedule: "0 45 2 * * *"          # 6-field CNPG cron (sec min hr dom mon dow)
  backupOwnerReference: self
  cluster:
    name: control-db
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
  immediate: false
