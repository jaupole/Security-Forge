# SecForge app-repo template — canonical multi-stage Dockerfile.
#
# Mirrors apps/helloworld-bff/Dockerfile (the reference consumer of
# apps/lib/api-auth/ + apps/lib/secrets/). Keep this in sync if the
# helloworld-bff Dockerfile evolves.
#
# Hadolint-clean: explicit COPY destinations (DL3045), JSON-array
# ENTRYPOINT (DL3025). Build context is the Go module root (containing
# go.mod / go.sum), not the repo root, unless the app uses a multi-module
# layout with apps/lib/ as a replace target — in which case the context
# is the parent directory (see helloworld-bff for the pattern).
#
# Build determinism:
#   - go.sum is committed; uses `go mod download` (read-only against the
#     lockfile), NOT `go mod tidy` (which can silently change a transitive
#     dep on rebuild).
#   - Source files are copied AFTER module fetch so layer caching
#     keeps subsequent rebuilds fast.

FROM golang:1.25-alpine@sha256:8d22e29d960bc50cd025d93d5b7c7d220b1ee9aa7a239b3c8f55a57e987e8d45 AS build
RUN apk add --no-cache ca-certificates
WORKDIR /src

COPY go.mod go.sum /src/
RUN go mod download -x

COPY . /src/

ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build \
    -trimpath \
    -ldflags "-s -w -buildid= -extldflags=-static" \
    -o /out/app \
    ./

# ─── Runtime ──────────────────────────────────────────────────────────
# distroless/static = no shell, no package manager, no busybox; only
# the binary plus the system CA bundle. Nothing for an attacker to
# pivot through.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639
USER 65532:65532

COPY --from=build /out/app /app

EXPOSE 8080
ENTRYPOINT ["/app"]
