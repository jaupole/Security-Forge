# SecForge app-repo template — .env.example
#
# This file documents NON-SECRET process configuration only. It is the
# ONLY .env* file allowed in the repo (see .gitignore).
#
# ⚠ Outbound credentials (Stripe, OpenAI, SendGrid, SAM.gov, etc.) do
# NOT live here and do NOT live in any .env file. They are fetched at
# runtime from OpenBao via apps/lib/secrets/. See README-secrets.md.
#
# If you find yourself wanting to add a key that contains the substring
# KEY, SECRET, TOKEN, PASSWORD, or CREDENTIAL — STOP. Read README-secrets.md
# instead. The Kyverno admission ClusterPolicy `no-secret-shaped-env-vars`
# (ADR-0013 § Layer 4) will reject the resulting Pod at deploy time.

LOG_LEVEL=info
PORT=8080

# OpenBao address — non-secret; the JWT-SVID at runtime is the credential,
# not this URL. Defaults to the in-cluster Service.
OPENBAO_ADDR=https://openbao.openbao.svc.cluster.local:8200

# SPIFFE workload API socket — non-secret; spiffe-helper writes the
# JWT-SVID to a file at this path. The path is what's sensitive at the
# filesystem layer, not the env var.
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/agent-sockets/api.sock
